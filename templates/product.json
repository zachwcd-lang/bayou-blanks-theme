{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "bayou-wholesale": {
      "type": "bayou-wholesale",
      "blocks": {
        "tier_1": {
          "type": "tier",
          "settings": {
            "name": "Tees, tanks, jerseys & polos",
            "units": "any size",
            "price": "99¢/unit"
          }
        },
        "tier_2": {
          "type": "tier",
          "settings": {
            "name": "Hoodies, fleece, sweats & outerwear",
            "units": "any size",
            "price": "$1.50/unit"
          }
        },
        "tier_3": {
          "type": "tier",
          "settings": {
            "name": "By the pack",
            "units": "4 · 6 · 12",
            "price": "per-unit pricing"
          }
        }
      },
      "block_order": [
        "tier_1",
        "tier_2",
        "tier_3"
      ],
      "settings": {
        "label": "For businesses",
        "heading": "Need 100+ of this style?",
        "text": "Same warehouse, better math. Case, half-pallet, and pallet pricing for printers, decorators, and resellers — shipped from Hattiesburg.",
        "button_label": "Get bulk pricing",
        "button_link": "/pages/contact",
        "footnote": "One flat price per unit — the same whether you buy a 4-pack or a pallet.",
        "background": "#FCFBF7"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "bayou-wholesale",
    "related-products"
  ]
}
