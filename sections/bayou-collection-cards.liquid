{%- comment -%}
  Bayou Blanks — Collection cards.
  Browse-by-category tiles. Each block points at a collection; the hero image
  falls back to the collection's first product photo when no collection/override
  image is set. On-brand rounded cards matching the product grid.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop | default: 3
-%}

{%- style -%}
  .bb-colcards {
    background-color: {{ s.background }};
    padding: 5.6rem 0;
  }

  @media screen and (min-width: 750px) {
    .bb-colcards {
      padding: 8rem 0;
    }
  }

  .bb-colcards__header {
    text-align: center;
    margin-bottom: 3.6rem;
  }

  .bb-colcards__eyebrow {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bb-moss, #5C7A3A);
    margin: 0 0 1.2rem;
  }

  .bb-colcards__title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 2.8rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bb-ink, #1A2415);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .bb-colcards__title {
      font-size: 3.4rem;
    }
  }

  .bb-colcards__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .bb-colcards__grid {
      grid-template-columns: repeat({{ cols }}, 1fr);
      gap: 2.4rem;
    }
  }

  .bb-colcard {
    display: block;
    text-decoration: none;
    border: 1px solid var(--bb-haze, rgba(26, 36, 21, 0.14));
    border-radius: var(--bb-radius-card, 8px);
    overflow: hidden;
    background: var(--bb-paper, #FAF8F2);
    transition: border-color 0.2s ease;
  }

  .bb-colcard:hover {
    border-color: var(--bb-ink-soft, #2D3B1E);
  }

  .bb-colcard__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bb-paper-deep, #F1ECDD);
  }

  .bb-colcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .bb-colcard:hover .bb-colcard__media img {
    transform: scale(1.03);
  }

  .bb-colcard__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bb-haze, rgba(26, 36, 21, 0.3));
  }

  .bb-colcard__placeholder svg {
    width: 40%;
    height: 40%;
  }

  .bb-colcard__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.4rem 1.6rem 1.6rem;
  }

  .bb-colcard__name {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--bb-ink, #1A2415);
    margin: 0;
  }

  .bb-colcard__count {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-ink-soft, #2D3B1E);
    opacity: 0.6;
    margin: 0.4rem 0 0;
  }

  .bb-colcard__arrow {
    flex: 0 0 auto;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    color: var(--bb-ink, #1A2415);
    transition: transform 0.2s ease;
  }

  .bb-colcard:hover .bb-colcard__arrow {
    transform: translateX(3px);
  }
{%- endstyle -%}

<section class="bb-colcards" id="bb-colcards-{{ section.id }}">
  <div class="page-width">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="bb-colcards__header">
        {%- if s.eyebrow != blank -%}
          <p class="bb-colcards__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="bb-colcards__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bb-colcards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign hero = block.settings.image | default: coll.featured_image
          assign label = block.settings.custom_title | default: coll.title
          assign count = coll.all_products_count
        -%}
        <a
          class="bb-colcard"
          href="{{ coll.url | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="bb-colcard__media">
            {%- if hero != blank -%}
              {{
                hero
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: label,
                  widths: '300, 450, 600, 800',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
              }}
            {%- else -%}
              <div class="bb-colcard__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
          <div class="bb-colcard__footer">
            <div>
              <h3 class="bb-colcard__name">{{ label | default: 'Collection' | escape }}</h3>
              {%- if count > 0 -%}
                <p class="bb-colcard__count">{{ count }} {% if count == 1 %}style{% else %}styles{% endif %}</p>
              {%- endif -%}
            </div>
            <span class="bb-colcard__arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Cards",
  "tag": "section",
  "class": "bayou-collection-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mono)",
      "default": "Shop the full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Blanks"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FAF8F2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "card",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)",
          "info": "Overrides the collection name on the card."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hero image override (optional)",
          "info": "Defaults to the collection's first product photo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
