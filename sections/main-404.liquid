<style type="text/css">
  .template-404 {
    padding: 12rem 0;
  }

  .template-404__line {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-ink, #1a2415);
    opacity: 0.6;
    margin: 0 0 1.2rem;
  }

  .template-404 .title {
    margin: 0 0 2.4rem;
  }
</style>

<div class="template-404 page-width page-margin center">
  <p class="template-404__line">{{ section.settings.kicker | default: '404' | escape }}</p>
  <h1 class="title">
    {{ section.settings.heading | default: 'NOTHING ON THIS SHELF.' | escape }}
  </h1>
  <a href="{{ section.settings.button_link | default: '/collections/in-stock' }}" class="button">
    {{ section.settings.button_label | default: 'SHOP IN STOCK' | escape }}
  </a>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker line",
      "default": "404 — PAGE NOT FOUND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOTHING ON THIS SHELF."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP IN STOCK"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
