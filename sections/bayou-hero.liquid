{%- style -%}
  .bayou-hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.height_mobile }}vh;
    display: flex;
    align-items: {{ section.settings.content_position }};
    justify-content: center;
    overflow: hidden;
    background-color: #22301B;
  }

  @media screen and (min-width: 750px) {
    .bayou-hero {
      min-height: {{ section.settings.height_desktop }}vh;
    }
  }

  /* --- Background: painterly image OR layered CSS scene --- */
  .bayou-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .bayou-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bayou-hero__bar {
    position: absolute;
    left: -10%;
    width: 120%;
  }

  .bayou-hero__bar--1 {
    top: -8%;
    height: 48%;
    background-color: #2D3B1E;
    opacity: 0.9;
    filter: blur(46px);
  }

  .bayou-hero__bar--2 {
    top: 34%;
    height: 36%;
    background-color: #46582E;
    opacity: 0.7;
    filter: blur(36px);
  }

  .bayou-hero__bar--3 {
    top: 64%;
    height: 44%;
    background-color: #A4B47A;
    opacity: 0.45;
    filter: blur(28px);
  }

  .bayou-hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 72% 28%, rgba(201, 185, 107, 0.22), transparent 70%);
  }

  .bayou-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(transparent 40%, rgba(26, 36, 21, 0.55));
    pointer-events: none;
  }

  /* --- Content --- */
  .bayou-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 80rem;
    padding: 6rem 2rem 5rem;
    text-align: center;
  }

  .bayou-hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 2.4rem;
    padding: 0;
    list-style: none;
  }

  .bayou-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 10px 16px;
    border-radius: var(--bb-radius-card, 4px);
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 500;
    font-size: 13px;
    line-height: 1.2;
    color: var(--bb-paper, #FAF8F2);
    white-space: nowrap;
  }

  .bayou-hero__chip-mark {
    display: inline-flex;
    align-items: center;
    color: var(--bb-paper, #FAF8F2);
  }

  .bayou-hero__chip-mark svg,
  .bayou-hero__chip-mark img {
    width: 16px;
    height: 16px;
    display: block;
  }

  .bayou-hero__chip-mark--text {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 13px;
  }

  .bayou-hero__chip-stars {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--bb-gold, #C9B96B);
  }

  .bayou-hero__kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 248, 242, 0.7);
    margin: 0 0 1.6rem;
  }

  .bayou-hero__heading {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: clamp(3.6rem, 2.55rem + 2.8vw, 5.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--bb-paper, #FAF8F2);
    margin: 0 0 1.6rem;
  }

  .bayou-hero__sub {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.55;
    color: rgba(250, 248, 242, 0.82);
    max-width: 52rem;
    margin: 0 auto 2.8rem;
  }

  .bayou-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
  }

  .bayou-hero__button {
    display: inline-block;
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    padding: 1.4rem 3rem;
    border-radius: var(--bb-radius-btn, 2px);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .bayou-hero__button--primary {
    background-color: var(--bb-paper, #FAF8F2);
    color: var(--bb-ink, #1A2415);
    border: 1px solid var(--bb-paper, #FAF8F2);
  }

  .bayou-hero__button--primary:hover {
    background-color: var(--bb-paper-deep, #F1ECDD);
    border-color: var(--bb-paper-deep, #F1ECDD);
    color: var(--bb-ink, #1A2415);
  }

  .bayou-hero__button--secondary {
    background-color: transparent;
    color: var(--bb-paper, #FAF8F2);
    border: 1px solid rgba(250, 248, 242, 0.7);
  }

  .bayou-hero__button--secondary:hover {
    border-color: var(--bb-paper, #FAF8F2);
    background-color: rgba(250, 248, 242, 0.08);
    color: var(--bb-paper, #FAF8F2);
  }

  @media screen and (max-width: 489px) {
    .bayou-hero__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-left: -2rem;
      margin-right: -2rem;
      padding: 0 2rem;
    }

    .bayou-hero__chips::-webkit-scrollbar {
      display: none;
    }
  }
{%- endstyle -%}

<section class="bayou-hero" id="bayou-hero-{{ section.id }}">
  <div class="bayou-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag: loading: 'eager', sizes: '100vw', widths: '600,900,1200,1800,2200', alt: ''
      }}
    {%- elsif section.settings.use_default_painting -%}
      <img src="{{ 'bayou-hero-painting.jpg' | asset_url }}" alt="" loading="eager" width="1536" height="658">
    {%- else -%}
      <div class="bayou-hero__bar bayou-hero__bar--1"></div>
      <div class="bayou-hero__bar bayou-hero__bar--2"></div>
      <div class="bayou-hero__bar bayou-hero__bar--3"></div>
      <div class="bayou-hero__glow"></div>
    {%- endif -%}
  </div>

  <div class="bayou-hero__scrim"></div>

  <div class="bayou-hero__content">
    {%- if section.blocks.size > 0 -%}
      <ul class="bayou-hero__chips" role="list">
        {%- for block in section.blocks -%}
          <li class="bayou-hero__chip bb-glass-dark" {{ block.shopify_attributes }}>
            {%- case block.settings.platform -%}
              {%- when 'tiktok' -%}
                <span class="bayou-hero__chip-mark" aria-hidden="true">
                  <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M10.511 1.705h2.74s-.157 3.51 3.795 3.768v2.711s-2.114.129-3.796-1.158l.028 5.606A5.073 5.073 0 1 1 8.213 7.56h.708v2.785a2.298 2.298 0 1 0 1.618 2.205z"/></svg>
                </span>
              {%- when 'whatnot' -%}
                <span class="bayou-hero__chip-mark" aria-hidden="true">
                  {%- if block.settings.mark_image != blank -%}
                    {{ block.settings.mark_image | image_url: width: 32 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <span class="bayou-hero__chip-mark--text">W·</span>
                  {%- endif -%}
                </span>
            {%- endcase -%}
            {%- if block.settings.rating > 0 -%}
              <span class="bayou-hero__chip-stars" role="img" aria-label="Rated {{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
              </span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="bayou-hero__chip-text">{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.kicker != blank -%}
      <p class="bayou-hero__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="bayou-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="bayou-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_primary_label != blank or section.settings.button_secondary_label != blank -%}
      <div class="bayou-hero__buttons">
        {%- if section.settings.button_primary_label != blank -%}
          <a href="{{ section.settings.button_primary_link }}" class="bayou-hero__button bayou-hero__button--primary">
            {{- section.settings.button_primary_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_secondary_label != blank -%}
          <a href="{{ section.settings.button_secondary_link }}" class="bayou-hero__button bayou-hero__button--secondary">
            {{- section.settings.button_secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bayou Hero",
  "tag": "section",
  "class": "bayou-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image — painterly artwork",
      "info": "Optional. Replaces the layered color scene. No warehouse or pallet photos."
    },
    {
      "type": "checkbox",
      "id": "use_default_painting",
      "label": "Use built-in bayou painting",
      "info": "When no hero image is picked, show the bundled painting instead of the layered color scene.",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker line",
      "default": "AUTHENTIC FANATICS OVERSTOCK · LICENSED LIQUIDATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pro-grade blanks. Liquidation prices."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub line",
      "default": "Authentic Fanatics overstock, inspected in Hattiesburg and sold by the pack at per-unit prices."
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Shop in stock"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Bulk pricing"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "label": "Desktop height (vh)",
      "default": 85
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "label": "Mobile height (vh)",
      "default": 70
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "chip",
      "name": "Social-proof chip",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform mark",
          "options": [
            { "value": "tiktok", "label": "TikTok" },
            { "value": "whatnot", "label": "Whatnot" },
            { "value": "none", "label": "None" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "mark_image",
          "label": "Custom mark image (optional)",
          "info": "Used for the Whatnot mark if set. 16px square works best."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "text",
          "label": "Chip text",
          "default": "1,000s of 5-star reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bayou Hero",
      "blocks": [
        {
          "type": "chip",
          "settings": { "platform": "tiktok", "rating": 5, "text": "1,000s of 5-star reviews" }
        },
        {
          "type": "chip",
          "settings": { "platform": "whatnot", "rating": 5, "text": "Top-rated seller" }
        }
      ]
    }
  ]
}
{% endschema %}
