{%- style -%}
  .bayou-tiktok {
    padding: 5.6rem 0 3.2rem;
  }

  @media screen and (min-width: 750px) {
    .bayou-tiktok {
      padding: 6.4rem 0 4.8rem;
    }
  }

  .bayou-tiktok__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .bayou-tiktok__inner {
      align-items: start;
    }
  }

  @media screen and (min-width: 750px) {
    .bayou-tiktok__inner {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .bayou-tiktok__proof {
    margin-top: 2.8rem;
  }

  .bayou-tiktok__heading {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: clamp(3.6rem, 2.55rem + 2.8vw, 5.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground));
    margin: 0 0 1.2rem;
  }

  .bayou-tiktok__handle {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 0 1rem;
  }

  .bayou-tiktok__subline {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.55;
    color: rgba(var(--color-foreground), 0.82);
    max-width: 44rem;
    margin: 0 0 2.4rem;
  }

  .bayou-tiktok__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .bayou-tiktok__button {
    display: inline-block;
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 500;
    font-size: 1.4rem;
    padding: 1.4rem 3rem;
    text-decoration: none;
    border-radius: var(--bb-radius-btn, 2px);
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .bayou-tiktok__button--primary {
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button));
  }

  .bayou-tiktok__button--primary:hover {
    opacity: 0.85;
    color: rgb(var(--color-button-text));
  }

  .bayou-tiktok__button--secondary {
    background-color: transparent;
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.6);
  }

  .bayou-tiktok__button--secondary:hover {
    border-color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.06);
    color: rgb(var(--color-foreground));
  }

  .bayou-tiktok__media-wrap {
    max-width: 32rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .bayou-tiktok__media-wrap {
      margin: 0 0 0 auto;
    }
  }

  .bayou-tiktok__media {
    aspect-ratio: 9 / 16;
    max-height: 44rem;
    overflow: hidden;
    border-radius: var(--bb-radius-card, 4px);
    border: 1px solid rgba(var(--color-foreground), 0.18);
    background-color: rgba(var(--color-foreground), 0.04);
  }

  .bayou-tiktok__media img,
  .bayou-tiktok__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bayou-tiktok__caption {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.65);
    margin: 1.2rem 0 0;
  }

  /* "The Bayou" badge — drives discovery of the resources hub. */
  .bayou-tiktok__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 1.8rem;
    padding: 6px 14px 6px 6px;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: rgba(var(--color-foreground), 0.05);
    border-radius: 999px;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .bayou-tiktok__badge:hover {
    border-color: rgba(var(--color-foreground), 0.5);
    background: rgba(var(--color-foreground), 0.1);
  }

  .bayou-tiktok__badge-tag {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--bb-gold, #C9B96B);
    color: var(--bb-ink, #1A2415);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .bayou-tiktok__badge-arr {
    color: var(--bb-gold, #C9B96B);
    font-size: 13px;
  }
{%- endstyle -%}

<section class="bayou-tiktok color-{{ section.settings.color_scheme }} gradient" id="bayou-tiktok-{{ section.id }}">
  <div class="page-width bayou-tiktok__inner">
    <div class="bayou-tiktok__content">
      {%- if section.settings.badge_label != blank -%}
        <a class="bayou-tiktok__badge" href="{{ section.settings.badge_link | default: '/pages/resources' }}">
          {%- if section.settings.badge_tag != blank -%}
            <span class="bayou-tiktok__badge-tag">{{ section.settings.badge_tag }}</span>
          {%- endif -%}
          <span class="bayou-tiktok__badge-text">{{ section.settings.badge_label }}</span>
          <span class="bayou-tiktok__badge-arr" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="bayou-tiktok__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.handle_line != blank -%}
        <p class="bayou-tiktok__handle">{{ section.settings.handle_line }}</p>
      {%- endif -%}

      {%- if section.settings.subline != blank -%}
        <p class="bayou-tiktok__subline">{{ section.settings.subline }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_secondary_label != blank -%}
        <div class="bayou-tiktok__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="bayou-tiktok__button bayou-tiktok__button--primary">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_secondary_label != blank -%}
            <a href="{{ section.settings.button_secondary_link }}" class="bayou-tiktok__button bayou-tiktok__button--secondary" target="_blank" rel="noopener">
              {{- section.settings.button_secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="bayou-tiktok__proof">
        {% render 'bayou-proof-pills' %}
      </div>
    </div>

    <div class="bayou-tiktok__media-wrap">
      <div class="bayou-tiktok__media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata' }}
        {%- elsif section.settings.video_asset != blank -%}
          <video autoplay loop muted playsinline preload="metadata">
            <source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,600,800'
          }}
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}
        <p class="bayou-tiktok__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bayou Live Hero",
  "tag": "section",
  "class": "bayou-tiktok-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "The Bayou badge"
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Badge tag (gold pill)",
      "default": "The Bayou"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "info": "Leave blank to hide the badge.",
      "default": "Buying guides & comparisons"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link",
      "info": "Defaults to /pages/resources if left blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live daily."
    },
    {
      "type": "text",
      "id": "handle_line",
      "label": "Handle line (mono)",
      "default": "@BAYOU.BLANKS · TIKTOK & WHATNOT"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Commerce subline",
      "default": "Authentic Fanatics overstock, sold by the pack at per-unit prices."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Follow @bayou.blanks"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify-hosted)"
    },
    {
      "type": "text",
      "id": "video_asset",
      "label": "Video asset filename (from assets folder)",
      "info": "e.g. hattiesburg-hero.mov"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (fallback if no video)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Video caption (mono)",
      "default": "LIVE FROM THE WAREHOUSE, DAILY."
    }
  ],
  "presets": [
    {
      "name": "Bayou Live Hero"
    }
  ]
}
{% endschema %}
