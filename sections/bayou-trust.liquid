{%- style -%}
  .bayou-trust {
    padding: 5.6rem 0;
    background-color: var(--bb-paper, #FAF8F2);
  }

  @media screen and (min-width: 750px) {
    .bayou-trust {
      padding: 9.6rem 0;
    }
  }

  .bayou-trust__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .bayou-trust__label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-moss, #5C7A3A);
    margin: 0 0 1.2rem;
  }

  .bayou-trust__title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 2.8rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bb-ink, #1A2415);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .bayou-trust__title {
      font-size: 3.4rem;
    }
  }

  .bayou-trust__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .bayou-trust__col {
    padding: 2.8rem 0;
    border-top: 1px solid var(--bb-haze, rgba(26, 36, 21, 0.14));
  }

  @media screen and (min-width: 750px) {
    .bayou-trust__grid {
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--bb-haze, rgba(26, 36, 21, 0.14));
    }

    .bayou-trust__col {
      border-top: none;
      padding: 3.2rem 2.8rem 0.8rem;
    }

    .bayou-trust__col + .bayou-trust__col {
      border-left: 1px solid var(--bb-haze, rgba(26, 36, 21, 0.14));
    }
  }

  .bayou-trust__figure {
    color: var(--bb-ink, #1A2415);
    margin: 0 0 2rem;
  }

  .bayou-trust__figure svg {
    width: 48px;
    height: 48px;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bayou-trust__caption {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 12px;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--bb-ink, #1A2415);
    margin: 0 0 1rem;
  }

  .bayou-trust__text {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: 1.4rem;
    line-height: 1.65;
    color: var(--bb-ink-soft, #2D3B1E);
    margin: 0;
  }
{%- endstyle -%}

<section class="bayou-trust" id="bayou-trust-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.label != blank or section.settings.heading != blank -%}
      <div class="bayou-trust__header">
        {%- if section.settings.label != blank -%}
          <p class="bayou-trust__label">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bayou-trust__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bayou-trust__grid">
      {%- for block in section.blocks -%}
        <div class="bayou-trust__col" {{ block.shopify_attributes }}>
          <div class="bayou-trust__figure" aria-hidden="true">
            {%- case block.settings.figure -%}
              {%- when 'box' -%}
                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6 L42 15 V33 L24 42 L6 33 V15 Z"/>
                  <path d="M6 15 L24 24 L42 15"/>
                  <path d="M24 24 V42"/>
                  <path d="M15 10.5 L33 19.5 V26"/>
                </svg>
              {%- when 'tag' -%}
                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                  <path d="M41.2 26.8 L26.8 41.2 a4 4 0 0 1 -5.6 0 L4 24 V4 H24 L41.2 21.2 a4 4 0 0 1 0 5.6 Z"/>
                  <circle cx="13" cy="13" r="2.5"/>
                  <polyline points="19 26 24 31 33 22"/>
                </svg>
              {%- when 'waves' -%}
                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="33" r="2"/>
                  <path d="M17 26 a10 10 0 0 1 14 0"/>
                  <path d="M12 20.5 a17 17 0 0 1 24 0"/>
                  <path d="M7 15 a24 24 0 0 1 34 0"/>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <h3 class="bayou-trust__caption">{{ block.settings.caption }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="bayou-trust__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bayou Trust Explainer",
  "tag": "section",
  "class": "bayou-trust-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Trust Bayou Blanks?"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "card",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "figure",
          "label": "Line drawing",
          "options": [
            { "value": "box", "label": "Case-pack box" },
            { "value": "tag", "label": "Inspection tag" },
            { "value": "waves", "label": "Live signal waves" }
          ],
          "default": "box"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Fig. caption (mono)",
          "default": "Fig. 1 — Sourced: authentic Fanatics overstock"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Body line",
          "default": "One short, honest sentence about this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bayou Trust Explainer",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "figure": "box",
            "caption": "Fig. 1 — Sourced: authentic Fanatics overstock",
            "text": "The same blanks the pros print on, bought through licensed liquidation channels at a fraction of retail."
          }
        },
        {
          "type": "card",
          "settings": {
            "figure": "tag",
            "caption": "Fig. 2 — Inspected: every case pack, Hattiesburg, MS",
            "text": "Every shipment is received, scanned, and condition-checked in our warehouse before it hits the site."
          }
        },
        {
          "type": "card",
          "settings": {
            "figure": "waves",
            "caption": "Fig. 3 — Sold live: daily on TikTok & Whatnot",
            "text": "Watch us pull, pack, and ship in real time — see the product before you buy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
