{%- style -%}
  .bayou-wholesale {
    background-color: var(--bb-ink, #1A2415);
    padding: 5.6rem 0;
  }

  @media screen and (min-width: 750px) {
    .bayou-wholesale {
      padding: 9.6rem 0;
    }
  }

  .bayou-wholesale__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media screen and (min-width: 750px) {
    .bayou-wholesale__inner {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: center;
    }
  }

  .bayou-wholesale__label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 248, 242, 0.6);
    margin: 0 0 1.2rem;
  }

  .bayou-wholesale__heading {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 2.8rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--bb-paper, #FAF8F2);
    margin: 0 0 1.4rem;
  }

  @media screen and (min-width: 750px) {
    .bayou-wholesale__heading {
      font-size: 3.4rem;
    }
  }

  .bayou-wholesale__text {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgba(250, 248, 242, 0.78);
    max-width: 44rem;
    margin: 0 0 2.8rem;
  }

  .bayou-wholesale__button {
    display: inline-block;
    font-family: var(--font-display, 'Inter', sans-serif);
    font-weight: 500;
    font-size: 1.4rem;
    padding: 1.4rem 3rem;
    background-color: var(--bb-paper, #FAF8F2);
    color: var(--bb-ink, #1A2415);
    text-decoration: none;
    border-radius: var(--bb-radius-btn, 2px);
    border: 1px solid var(--bb-paper, #FAF8F2);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .bayou-wholesale__button:hover {
    background-color: var(--bb-paper-deep, #F1ECDD);
    border-color: var(--bb-paper-deep, #F1ECDD);
    color: var(--bb-ink, #1A2415);
  }

  /* --- Glass price panel (sanctioned glass surface) --- */
  .bayou-wholesale__panel {
    border-radius: var(--bb-radius-card, 4px);
    padding: 0.8rem 2.4rem;
  }

  .bayou-wholesale__tier {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 1.6rem;
    padding: 1.8rem 0;
  }

  .bayou-wholesale__tier + .bayou-wholesale__tier {
    border-top: 1px solid var(--bb-glass-border, rgba(250, 248, 242, 0.22));
  }

  .bayou-wholesale__tier-name {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-paper, #FAF8F2);
  }

  .bayou-wholesale__tier-units {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 248, 242, 0.6);
  }

  .bayou-wholesale__tier-price {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 1.4rem;
    color: var(--bb-paper, #FAF8F2);
    text-align: right;
  }

  .bayou-wholesale__footnote {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-gold, #C9B96B);
    border-top: 1px solid var(--bb-glass-border, rgba(250, 248, 242, 0.22));
    padding: 1.6rem 0 1rem;
    margin: 0;
  }
{%- endstyle -%}

<section class="bayou-wholesale" id="bayou-wholesale-{{ section.id }}">
  <div class="page-width bayou-wholesale__inner">
    <div class="bayou-wholesale__left">
      {%- if section.settings.label != blank -%}
        <p class="bayou-wholesale__label">{{ section.settings.label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="bayou-wholesale__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="bayou-wholesale__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="bayou-wholesale__button">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="bayou-wholesale__panel bb-glass-dark">
        {%- for block in section.blocks -%}
          <div class="bayou-wholesale__tier" {{ block.shopify_attributes }}>
            <span class="bayou-wholesale__tier-name">{{ block.settings.name }}</span>
            <span class="bayou-wholesale__tier-units">{{ block.settings.units }}</span>
            <span class="bayou-wholesale__tier-price">{{ block.settings.price }}</span>
          </div>
        {%- endfor -%}
        {%- if section.settings.footnote != blank -%}
          <p class="bayou-wholesale__footnote">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bayou Bulk Band",
  "tag": "section",
  "class": "bayou-wholesale-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "For businesses"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Printing at volume?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body line",
      "default": "Case, half-pallet, and pallet pricing for printers, decorators, and resellers — shipped from Hattiesburg."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Talk to us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Panel footnote (gold)",
      "default": "Placeholder pricing — talk to us for a current quote"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tier",
      "name": "Price tier",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Tier name",
          "default": "Case"
        },
        {
          "type": "text",
          "id": "units",
          "label": "Units",
          "default": "48 units"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price text",
          "info": "Placeholder — edit with real pricing.",
          "default": "$2.00/unit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bayou Bulk Band",
      "blocks": [
        {
          "type": "tier",
          "settings": { "name": "Case", "units": "48 units", "price": "$2.00/unit" }
        },
        {
          "type": "tier",
          "settings": { "name": "Half pallet", "units": "288 units", "price": "$1.75/unit" }
        },
        {
          "type": "tier",
          "settings": { "name": "Pallet", "units": "576+ units", "price": "$1.50/unit" }
        }
      ]
    }
  ]
}
{% endschema %}
